.{
    .name = .grpc_zig,
    .version = "0.1.0",
    .fingerprint = 0xbcaa61f2a4ef59ec,
    .dependencies = .{
        .zlib = .{
            .url = "https://github.com/madler/zlib/archive/refs/tags/v1.3.1.tar.gz",
            .hash = "N-V-__8AAB0eQwD-0MdOEBmz7intriBReIsIDNlukNVoNu6o",
        },
        // otel — only fetched when -Dwith_otel=true reaches the
        // `b.lazyDependency("otel", ...)` call in build.zig. With the
        // flag off, Zig never resolves this entry, keeping disabled
        // builds hermetic and free of otel symbols. Pin tracked in
        // otel/docs/plan/otel-rollout.md Task 0.3.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#e7a0fca548524061bb89aa1e0956709d412438d1",
            .hash = "otel-0.1.0-B0v3lpwNNAAeClYawUg8O3BtgOdMPhevogg0BkyAaGM2",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "integration_test",
        "README.md",
        "LICENSE",
    },
}
