.{
    .name = .grpc_zig,
    .version = "0.1.16",
    .fingerprint = 0xbcaa61f2a4ef59ec,
    .dependencies = .{
        .zlib = .{
            .url = "https://github.com/madler/zlib/archive/refs/tags/v1.3.2.tar.gz",
            .hash = "N-V-__8AAI4ANwDM8MWhHTUFLKfvLE_n2NQk6mh0sFDzhTqO",
        },
        // FIPS-140-3 backend. Resolved ONLY under -Dfips=true (lazy).
        // SONNY-1852: pinned to the published fips via git+https so
        // `-Dfips=true` and CI resolve it from the registry instead of a
        // machine-specific build-root-relative `.path` (which only existed on
        // the author's disk and broke every other checkout). Pinned by
        // tag AND exact commit (fips v0.1.2, #2db29e0a) so a re-cut tag can't
        // silently change the content hash (the v0.1.1 tag was re-cut once,
        // #4041d9cf -> #8b006e08). Keep in lockstep with the spine's fips pin.
        .fips = .{
            .url = "git+https://gitlab.com/devnw/zig/fips.git?ref=v0.1.4#b28d7f1d4ea0f0cb7e00d5bdbf3e4c788b1e02fd",
            .hash = "fips-0.1.4-1wf3nXbXCgB1B18pFjHT6l3wK5O09--Ig9DGon7IpzyD",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "interop",
        "examples",
        "integration_test",
        "README.md",
        "LICENSE",
    },
}
